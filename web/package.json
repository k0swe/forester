{
  "name": "forester",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prebuild-prod": "ts-node -O '{\"module\": \"commonjs\", \"moduleResolution\": \"node\", \"types\": [\"node\"]}' git-version.ts",
    "build-prod": "ng build --configuration production",
    "test": "firebase emulators:exec --project k0swe-kellog 'ng test'",
    "test-ci": "firebase emulators:exec --project k0swe-kellog --only firestore 'ng test --no-watch --no-progress'",
    "lint": "ng lint",
    "license-report": "license-report --config license-report-config.json > src/assets/license-report.json && git add src/assets/license-report.json"
  },
  "private": true,
  "browser": {
    "fs": false,
    "net": false,
    "os": false,
    "path": false,
    "tls": false
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@amrato/maidenhead-ts": "2.0.0",
    "@angular/animations": "22.1.4",
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/google-maps": "22.1.4",
    "@angular/localize": "22.1.4",
    "@angular/material": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-browser-dynamic": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/service-worker": "22.1.4",
    "@googlemaps/js-api-loader": "2.1.1",
    "@types/long": "5.0.0",
    "adif-parser-ts": "0.7.7",
    "firebase": "12.18.0",
    "google-protobuf": "4.0.2",
    "js-joda": "1.11.0",
    "json-ptr": "3.1.1",
    "lodash.isequal": "4.5.0",
    "moment": "2.30.1",
    "ngx-kel-agent": "2.0.0",
    "rxjs": "7.8.2",
    "ts-protoc-gen": "0.15.0",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/google.maps": "3.65.5",
    "@types/lodash.isequal": "4.5.8",
    "@types/node": "26.3.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "angular-eslint": "^22.1.0",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "license-report": "6.8.5",
    "lint-staged": "17.3.0",
    "open": "11.0.2",
    "prettier": "3.9.6",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,ts,json,html,css,scss,md,yml,yaml,webmanifest}": "prettier --write"
  },
  "prettier": {
    "singleQuote": true,
    "importOrder": [
      "<THIRD_PARTY_MODULES>",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrderParserPlugins": [
      "typescript",
      "decorators-legacy"
    ],
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  }
}
